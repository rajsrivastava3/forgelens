{
  "name": "forgelens",
  "displayName": "ForgeLens",
  "description": "A coding agent for VS Code whose agent loop runs on TrueForge. Nothing touches disk until a human accepts a hunk, and the agent always shows what it read and why.",
  "version": "0.0.1",
  "publisher": "rajsrivastava3",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rajsrivastava3/forgelens.git"
  },
  "homepage": "https://github.com/rajsrivastava3/forgelens#readme",
  "bugs": {
    "url": "https://github.com/rajsrivastava3/forgelens/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgelens",
          "title": "ForgeLens",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forgelens": [
        {
          "type": "webview",
          "id": "forgelens.panel",
          "name": "Agent"
        },
        {
          "id": "forgelens.changes",
          "name": "Changes",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "forgelens.setup",
        "title": "ForgeLens: Set up TrueForge"
      },
      {
        "command": "forgelens.stop",
        "title": "ForgeLens: Stop"
      },
      {
        "command": "forgelens.newChat",
        "title": "ForgeLens: New chat"
      },
      {
        "command": "forgelens.undo",
        "title": "ForgeLens: Undo last applied change"
      },
      {
        "command": "forgelens.review.acceptHunk",
        "title": "Accept hunk",
        "category": "ForgeLens",
        "icon": "$(check)"
      },
      {
        "command": "forgelens.review.rejectHunk",
        "title": "Reject hunk",
        "category": "ForgeLens",
        "icon": "$(close)"
      },
      {
        "command": "forgelens.review.acceptAll",
        "title": "Accept all hunks",
        "category": "ForgeLens",
        "icon": "$(check-all)"
      },
      {
        "command": "forgelens.review.rejectAll",
        "title": "Reject all hunks",
        "category": "ForgeLens",
        "icon": "$(close-all)"
      },
      {
        "command": "forgelens.review.apply",
        "title": "Apply decisions",
        "category": "ForgeLens",
        "icon": "$(save)"
      },
      {
        "command": "forgelens.review.open",
        "title": "Open review",
        "category": "ForgeLens"
      },
      {
        "command": "forgelens.editSelection",
        "title": "ForgeLens: Edit selection"
      },
      {
        "command": "forgelens.pickModel",
        "title": "ForgeLens: Choose model"
      }
    ],
    "keybindings": [
      {
        "command": "forgelens.stop",
        "key": "escape",
        "when": "focusedView == forgelens.panel"
      },
      {
        "command": "forgelens.editSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "forgelens.stop",
        "key": "escape",
        "when": "forgelens.running && editorTextFocus && !suggestWidgetVisible && !findWidgetVisible && !renameInputVisible"
      }
    ],
    "configuration": {
      "title": "ForgeLens",
      "properties": {
        "forgelens.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Where TrueForge is running."
        },
        "forgelens.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "google-gemini/gemini-3-8-flash",
            "gemini-free/gemini-flash-lite-latest"
          ],
          "markdownDescription": "TrueForge model names, in order. The first that TrueForge has is the primary; the rest are fallbacks, used automatically when it fails. Pick from what TrueForge has with **ForgeLens: Choose model** (the model in the status bar)."
        },
        "forgelens.mcpPort": {
          "type": "number",
          "default": 8799,
          "description": "Local port for the editor tools server that TrueForge connects to."
        },
        "forgelens.panel.largeText": {
          "type": "boolean",
          "default": false,
          "description": "Use larger text in the agent panel, for recording."
        },
        "forgelens.context.budgetTokens": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "How many tokens of code ForgeLens adds to each agent request as the Context Pack."
        },
        "forgelens.review.inlineDiff": {
          "type": "boolean",
          "default": true,
          "description": "Show review diffs inline rather than side by side, so long lines stay readable on a small screen. Your own layout setting comes back when the review closes."
        },
        "forgelens.commands.autoApprove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "pytest",
            "python -m pytest",
            "git status",
            "git diff"
          ],
          "description": "Commands the agent may run without asking, each still going through the TrueForge approval. A command with shell syntax such as ; or | always asks."
        },
        "forgelens.firstTokenTimeoutSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 5,
          "description": "If a model sends nothing within this many seconds, ForgeLens retries it and then falls back. Applies only before the first output."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "forgelens.review.acceptAll",
          "when": "resourceScheme == forgelens-proposed && forgelens.reviewing",
          "group": "navigation@1"
        },
        {
          "command": "forgelens.review.rejectAll",
          "when": "resourceScheme == forgelens-proposed && forgelens.reviewing",
          "group": "navigation@2"
        },
        {
          "command": "forgelens.review.apply",
          "when": "resourceScheme == forgelens-proposed && forgelens.reviewing",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "forgelens.review.acceptAll",
          "when": "view == forgelens.changes && forgelens.reviewing",
          "group": "navigation@1"
        },
        {
          "command": "forgelens.review.rejectAll",
          "when": "view == forgelens.changes && forgelens.reviewing",
          "group": "navigation@2"
        },
        {
          "command": "forgelens.review.apply",
          "when": "view == forgelens.changes && forgelens.reviewing",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "forgelens.review.acceptHunk",
          "when": "view == forgelens.changes && viewItem == hunk",
          "group": "inline@1"
        },
        {
          "command": "forgelens.review.rejectHunk",
          "when": "view == forgelens.changes && viewItem == hunk",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "forgelens.review.acceptHunk",
          "when": "false"
        },
        {
          "command": "forgelens.review.rejectHunk",
          "when": "false"
        },
        {
          "command": "forgelens.review.acceptAll",
          "when": "forgelens.reviewing"
        },
        {
          "command": "forgelens.review.rejectAll",
          "when": "forgelens.reviewing"
        },
        {
          "command": "forgelens.review.apply",
          "when": "forgelens.reviewing"
        },
        {
          "command": "forgelens.review.open",
          "when": "forgelens.reviewing"
        }
      ],
      "editor/context": [
        {
          "command": "forgelens.editSelection",
          "when": "editorTextFocus && !editorReadonly && resourceScheme == file",
          "group": "1_modification@1"
        }
      ]
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true,
      "diffEditor.wordWrap": "on"
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:trueforge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-trueforge.ps1",
    "spike": "tsx scripts/spike-p0.ts",
    "prepare": "git config core.hooksPath .githooks",
    "test:e2e": "node test/e2e/launch.mjs",
    "rehearse:a": "tsx scripts/rehearse-a.ts",
    "rehearse:b": "tsx scripts/rehearse-b.ts",
    "rehearse:c": "tsx scripts/rehearse-c.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.183.0",
    "diff": "^8.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
