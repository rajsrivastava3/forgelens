{
  "name": "forgelens",
  "displayName": "ForgeLens",
  "description": "A coding agent for VS Code whose agent loop runs on TrueForge. Nothing touches disk until a human accepts a hunk, and the agent always shows what it read and why.",
  "version": "0.0.1",
  "publisher": "hackbuddy1",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rajsrivastava3/forgelens.git"
  },
  "homepage": "https://github.com/rajsrivastava3/forgelens#readme",
  "bugs": {
    "url": "https://github.com/rajsrivastava3/forgelens/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgelens",
          "title": "ForgeLens",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forgelens": [
        {
          "type": "webview",
          "id": "forgelens.panel",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "forgelens.setup",
        "title": "ForgeLens: Set up TrueForge"
      },
      {
        "command": "forgelens.stop",
        "title": "ForgeLens: Stop"
      },
      {
        "command": "forgelens.newChat",
        "title": "ForgeLens: New chat"
      }
    ],
    "keybindings": [
      {
        "command": "forgelens.stop",
        "key": "escape",
        "when": "focusedView == forgelens.panel"
      }
    ],
    "configuration": {
      "title": "ForgeLens",
      "properties": {
        "forgelens.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Where TrueForge is running."
        },
        "forgelens.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "TrueForge model names, in order of preference, such as `provider/model`. The first one TrueForge has is used. When empty, ForgeLens uses the first model TrueForge lists."
        },
        "forgelens.mcpPort": {
          "type": "number",
          "default": 8799,
          "description": "Local port for the editor tools server that TrueForge connects to."
        },
        "forgelens.panel.largeText": {
          "type": "boolean",
          "default": false,
          "description": "Use larger text in the agent panel, for recording."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:trueforge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-trueforge.ps1",
    "spike": "tsx scripts/spike-p0.ts",
    "prepare": "git config core.hooksPath .githooks",
    "test:e2e": "node test/e2e/launch.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.183.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
